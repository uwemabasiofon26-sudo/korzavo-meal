# Copy this file to .env.local for local development (never commit .env.local).
# In production, set these in Vercel: Project Settings -> Environment Variables.

# --- Orders (keep OFF until delivery fees, areas and availability are confirmed) ---
ORDERING_OPEN=false
VITE_ORDERING_OPEN=false

# --- Who can order ---
# Anyone can browse. Orders are only taken from New Zealand (Vercel IP lookup)
# AND deliveries must go to a postcode below (Tauranga). To test from outside
# New Zealand, set ORDER_LOCATION_CHECK=off (and remove it again before launch).
ORDER_LOCATION_CHECK=on
# CONFIRM: postcodes you deliver to (server) and the same list for the website.
DELIVERY_POSTCODES=3110,3112,3116,3118
VITE_DELIVERY_POSTCODES=3110,3112,3116,3118
# Delivery fee in NZD, added to every order (0 = free delivery). Required to take orders.
DELIVERY_FEE_NZD=

# --- Site ---
SITE_URL=https://korzavomeals.com
VITE_SITE_URL=https://korzavomeals.com
VITE_CONTACT_EMAIL=uwem@korzavo.com
VITE_CORPORATE_EMAIL=info@korzavo.com

# --- Stripe ---
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret-here

# --- Email (Resend; the sending domain korzavo.com must be verified in Resend) ---
RESEND_API_KEY=your-resend-api-key-here
RESEND_AUDIENCE_ID=your-resend-audience-id-here
ORDER_NOTIFICATION_FROM=KORZAVO MEALS <support@korzavo.com>
# New orders arrive here the moment they are paid
ORDER_NOTIFICATION_EMAIL=support@korzavo.com
# Questions from the website contact form
CONTACT_NOTIFICATION_EMAIL=uwem@korzavo.com
# Corporate / gym partnership enquiries from the contact form
CORPORATE_NOTIFICATION_EMAIL=info@korzavo.com
# Optional: kitchen / fulfilment address that should also receive each new order
SUPPLIER_NOTIFICATION_EMAIL=

# --- Testing (remove before going live) ---
# Shows a "TEST MODE" hint with the Stripe test card in the cart.
VITE_TEST_MODE=false
