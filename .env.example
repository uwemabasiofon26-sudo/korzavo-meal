# Copy this file to .env.local for local development (never commit .env.local).
# In production, set these in Vercel: Project Settings -> Environment Variables.

# --- Orders (keep OFF until delivery fees, areas and availability are confirmed) ---
ORDERING_OPEN=false
VITE_ORDERING_OPEN=false

# --- Site ---
SITE_URL=https://korzavomeals.co.nz
VITE_SITE_URL=https://korzavomeals.co.nz
VITE_CONTACT_EMAIL=hello@korzavomeals.co.nz
VITE_CORPORATE_EMAIL=corporate@korzavomeals.co.nz

# --- Stripe ---
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret-here
# Delivery fee: create it in Stripe (Settings -> Shipping) once confirmed, paste its ID here.
STRIPE_SHIPPING_RATE_NZ=your-nz-delivery-rate-id-here

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key-here
RESEND_AUDIENCE_ID=your-resend-audience-id-here
ORDER_NOTIFICATION_FROM=orders@korzavomeals.co.nz
ORDER_NOTIFICATION_EMAIL=orders@korzavomeals.co.nz
CONTACT_NOTIFICATION_EMAIL=hello@korzavomeals.co.nz
# Optional: kitchen / fulfilment address that should also receive each new order
SUPPLIER_NOTIFICATION_EMAIL=
